<style>
  /* M20.5: a responsive page, its rules in cascade layers and behind
     feature queries, with breakpoints at 640 and 1024 pixels; the same
     page as responsive-narrow, -medium and -wide, here between them, at 800 pixels. */
  @font-face { font-family: "Layout Test Sans"; src: url(../../../text/fonts/DejaVuSans.ttf); }
  @layer reset, base, layout, components;
  @layer reset {
    body, h1, h2, h3, p, ul { margin: 0; padding: 0; }
    /* Important in the first layer: over every later one's. */
    .card h3 { margin: 0 0 6px !important; }
  }
  @layer base {
    body { font-family: "Lay #24292f; color: #f6f8fa; }
</style>
