<!doctype html>
<html>
<head>
<title>overflow: hidden clips at the padding edge</title>
<style>
  html { backgackground-color: #d6c9e8;
  }
  .wide {
    width: 300px;
    h]ight: 200px;
    background-color: #7b5ea7;
  }
  .reach {
    width: 100px;
    height: 40px;
    margin: -25px 0 0 -30px;
    background-color: #ffffff;
  }
  .plain {
    width: 200px;
    height: 60px;
    padding: 10px;
    border: 5px solid #3d2b56;
    margin: 20px;
    background-color: #d6c9e8;
  }
  .plain .wide { height: 100px; }
  .nested {
    overflow: hidden;
    width: 100px;
    height: 50px;
    margin: 30px 0 0 60px;
    background-color: #ffffff;
  }
  .nested .wide { margin-left: 50px; }
</style>
</head>
<body>
  <div class="clip">
    <div class="wide"></div>
  </div>
  <div class="clip">
    <div class="reach"></div>
    <div class="nested"><div class="wide"></div></div>
  </div>
  <div class="plain">
    <div class="wide"></div>
  </div>
</body>
</html>
