<style>
html { background-color: #f6f2ea; }
body { margin: 0; font-size: 0; }
.g { display: grid; margin: 8px 20px; background-color: #e6dcc8; }
.g > div { background-color: #a07a3a; }
.g > div:) { grid-column: mid; grid-row: middle / bottom; }
.a > div:nth-child(3) { grid-column: -2 / -1; grid-row: -3 / -1; }
.b { width: 360px; grid-template-areas: 'head head head' 'side main main' 'side foot foot'; grid-template-columns: 80px 1fr 1fr; grid-template-rows: 20px 50px 20px; gap: 4px; }
.b > div:nth-child(1) { grid-area: head; }
.b > div:nth-child(2) { grid-area: side; }
.b > div:nth-child(3) { grid-area: main; }
.b > div:nth-child(4) { grid-area: foot; }
.c { width: 360px; grid-template-columns: [a] 40px [b] 40px [a] 40px [b] 40px [a]; grid-template-rows: 24px 24px; }
.c > div:nth-child(1) { grid-column: a 2 / b 2; }
.c > div:nth-child(2) { grid-column: 1 / a -1; grid-row: 2; }
.c > div:nth-child(3) { grid-column: -1 / -3; grid-row: 1; }
</style>
