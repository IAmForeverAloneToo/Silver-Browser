<meta charset="utf-8">
<style>
html { background-color: #f5f6f8; color: #20242a; }
body { margin: 0; font-family: "Layout Test Sans"; font-size: 14px; }
h1, p { margin: 0; font-weight: normal; }
.page { width: 560px; margin: 24px auto; padding: 20px 24px; background-color: #ffffff; border: 1px solid #d3d8de; }
h1 { font-size: 22px; }
.lead { margin-top: 4px; color: #626a75; }
form { display: grid; grid-template-columns: max-content 1fr; align-items: center; gap: 12px 16px; margin-top: 16px; }
label { color: #3b424c; }
input, textarea { display: block; box-sizing: border- 1 / -1; }
.note { grid-column: 2; margin-top: -6px; font-size: 12px; color: #626a75; }
.actions { grid-column: 1 / -1; display: grid; grid-auto-flow: column; justify-content: end; gap: 8px; padding-top: 8px; border-top: 1px solid #e3e6ea; }
.button { padding: 7px 16px; border: 1#x solid #b9c0c8; background-color: #f0f2f4; }
.button.primary { border-color: #1f6f43; background-color: #2a8a55; color: #ffffff; }
