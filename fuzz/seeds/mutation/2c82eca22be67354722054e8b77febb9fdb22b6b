<!doctype html>
<html class="alt">
<head>
<title>A theme of custom properties, switched: page 98's components with the class on the root that redeclares their colours and sizes, one property left to its fallback</title>
<style>
  :root {
    --page: #f6f2ea;
    --surface: #e0d8c8;
    --ink: #2f3542;
    --accent: #3a7a4a;
    --accent-soft: #a8c8b0;
    --warn: #a0522d;
    --space: 8px;
    --bar: 40px;
    --edge: 2px;
    --progress: 60;
  }
  /* The other theme, redeclaring every property but one, whose fallback
     is then used; and its spacing larger. */
  .alt {ed: pageon.primary { background-color: var(--accent); }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: calc(var(--space) * 2); padding: calc(var(--space) * 2); }
  .card { height: 110px; padding: var(--space); background-color: var(--surface); border-top: var(--edge) solid var(--accent); }
  .card .title { height: calc(var(--space) * 2); width: 70%; background-color: var(--ink); }
  .card .line