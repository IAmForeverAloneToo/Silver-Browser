<!doctype html>
<html>
<head>
<title>Grid: repeat() with a count, auto-fill and auto-fit, with gaps</title>
<style
  i { display: block; background-color: #3a5a7a; }
  .a { width: 360px; grid-template-columns: repeat(3, 40px 1fr); grid-template-rows: 24px; column-gap: 6px; }
  .b { width: 360px; grid-template-columns: repeat(auto-fill, 50px); grid-auto-rows: 20px; gap: 10px; }
  .c { width: 360px; grid-template-columns: repeat(auto-fit, 50px); grid-auto-rows: 20px; gap: 10px; justify-content: center; }
  .d { width: 360px; grid-template-columns: repeat(auto-fill, minmax(70px, 1fr)); grid-auto-rows: 20px; gap: 4px; }
  .e { width: 360px; grid-template-columns: repeat(auto-fit, minmax(70px, 1fr)); grid-auto-rows: 20px; gap: 4px; }
  .f { width: 360px; grid-template-columns: 20px repeat(2, [x] 30px [y]) repeat(auto-fill, 60px) 20px; grid-auto-rows: 20px; }

</style>
</head>
<body>
  <div class="col">
    <div class="g a"><div></div><div></div><div></div><div></div><div></div><div></div></div>
  