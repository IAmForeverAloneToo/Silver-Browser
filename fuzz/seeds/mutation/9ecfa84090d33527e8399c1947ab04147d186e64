<!doctype html>
<html>
<head>
<title>Generated boxes: ::before and ::after as tables and table cells, and the clearfix</title>
<style>
  html { background-color: #f5f1e8; }
  body { margin: 0; }
  .clearfix { width: 400px; margin: 20px; background-color: #e2d8c0; }
  .clearfix::after { content: ""; display: table; clear: both; }
  .clearfix div { float: left; width: 100px; height: 60px; margin-color: #7a6431; }
  .cells div { width: 80px; height: 50px; background-color: #5c4a22; }
  .tables::before { content: ""; display: table; width: 200px; height: 30px; margin: 0 20px; background-color: #5c4a22; }
  .tables::after { content: ""; display: table; width: 100px; height: 20px; margin: 10px 20px; background-color: #b39a5e; }
</style>
</head>
<body>
  <div class="clearfix"><div></div><div></div></div>
  <div class="open"><div></div></div>
  <table><tr><td><div></div></td><td><div></di-right: 10px; background-color: #8a7444; }
  .open { width: 400px; margin: 20px; background-color: #e2d8c0; }
 