<!doctype html>
<html>
<head>
<title>Silver Browser</title>
<style>
  html { background-color: #1e1e2e; }
  h1 { color: #cdd6f4; }
  p { color: #a6adc8; }
  .highlight { color: #f9e2af; font-size: 20px; }
  .cards {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 16px;
    margin: 16px 0;
  }
  .card {
    display: block;
    flex: 1 1 220px;
    padding: 12px;
    border-width: 2px;
    border-style: solid;
    border-color: #89b4fa;
    background-color: #313244;
  }
  .card::before {
    content: attr(data-label);
    display: block;
    margin-bottom: 4px;
    color: #89b4fa;
    font-size: 12px;
    text-transform: uppercase;
  }
  .card::after { content: "§"; display: block; text-align: right; color: #6c7086; }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    grid-auto-flow: dense;
    gap: 8px;
    margin: 16px 0;
  }
