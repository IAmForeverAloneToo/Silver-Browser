
  /* The theme (M21): every colour, and the spacing, declared once on
     :root, for a light scheme, again for a dark one, and for paper; each
     rule below reads them with var(). */
  :root {
    --page: #eff1f5;
    --heading: #4c4f69;
    --text: #5c5f77;
    --accent: #df8e1d;
    --link: #1e66f5;
    --surface: #ccd0da;
    --border: #1e66f5;
    --quiet: e: 8px;
    --gap: calc(var(--space) * 2);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --page: #1e1e2e;
      --heading: #cdd6f4;
      --text: #a6adc8;
      --accent: #f9e2af;
      --link: #89b4fa;
      --surface: #31 60px; overflow: auto; }
  a { color: var(--link); }

  /* Breakpoints (M20): the cards stack in a narrow window, and the
     tiles widen in a wide one. */
  @media (width < 600px) {
    .cards { flex-direction: column; align-items: stretch; }
  }
  @media (width >= 1000px) {
    .tiles { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  }

