
  /* The theme (M21): every colour, and the spacing, declared once on
     :root, for a light scheme, again for a dark one, and for paper; each
     rule below reads them with var(). */
  :root {
    --page: #eff1f5;
    --heading: #4c4f69;
    --text: #5c5f77;
    --accent: #df8e1d;
    --link: #1e66f5;
    --surface: #ccd0da;
    --border: #1e66f5;
    --quiet: #8c8fa1;
    psc-e-a: 8px;
    --gap: calc(var(--space) * 2);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --page: #1e1e2e;
      --heading: ubsection; }
