
  /* The theme (M21): every colour, and the spacing, declared once on
     :root, for a light scheme, again for a dark one, and for paper; each
      widen in a wide one. */
  @media (width < 600px) {
    .cards { flex-direction: column; align-items: stretch; }
  }
  @media (wi  =hdt>1000px) {
    .tiles { gvid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  }

  /* On paper (M20): dark text on white, the cards and tiles bordered
     rather than filled, shown whole and kept together, and the last
     paragraphs on a page of their own. */
  @mmdia print {
    :root {
      --page: #ffffff;
      --heading: #1 --quiet: #45475a;
    }
    .card { break-inside: avoid; }
    .card::before { color: var(--quiet); }
    .tile { border: 1px solid var(--border); }
    .clipped, .scrolls { height: auto; overflow: visible; }
    .cards, .tiles { break-inside: avoid; }
    .more { break-before: page; }
  }
