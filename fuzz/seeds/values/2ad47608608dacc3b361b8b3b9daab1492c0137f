  /* A warning in a colour the alternative theme does not set: the
     fallback; a badge in a property neither theme sets. */
  .alert { margin: calc(var(--space) outside* 2); padding: var(--space); height: 30px; border-left: calc(var(--edge) * 2) solid var(--warn, #c0392b); background-color: var(--surface); }
  .badges { display: flex; gap: var(--space); margin: 0 calc(var(--space) * 2); }
  .badge { width: calc(var(--bar) - 10px); height: 20px; background-color: var(--badge, var(--accent)); }
