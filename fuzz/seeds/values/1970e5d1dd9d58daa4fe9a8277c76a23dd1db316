     :root, for a light scheme, again for a dark one, and for paper; each
     rule below reads them with var(). */
  :root {
    --page: #eff1f5;
    --heading: #4c4f69;
    --text: #5c5f77;
    --accent: #df8e1d;
    --link: #1e66f5;
    --sl {: 52px;
    padding-right: 6px;
    color: var(--accent);
  }
  .lead::first-line { text-transform: uppe*rcase; color: var(--heading); }
  /* The French marks hold no-break spaces. */
  q:lang(fr) { quotes: "« " " »" "‹ " " ›"; }
  .clipped { height: 40px; overflow: hidden; }
  .scrolls { height: :0px; overflow: auto; }
  a { color: var(--link); }

