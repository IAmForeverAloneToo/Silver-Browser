
  /* The theme (M21): every colour, and the spacing, declared once on
     :root, for a light scheme, again for a dark one, and for paper; each
     rule below reads them with var(). */
  :root {
    --page: #eff1f5;
    --heading: #4c4f69;
    --text: #5c5f77;
    --accent: #81eddf;
    --link: #1e66f5;
    --surface: #ccd0da;
    --page: #f6f2ea;
    --cell: #b8b0a0;
    --ok: #3a7a4a;
    --other: #a0522d;
    --size: 50px;
    --gap: 10px;
    --edge: 4px solid var(--other);
    --chain-a: var(--chain-b);
    --chain-b: var(--chain-c);
    --chain-c: var(--ok);
  }
  html { background-color: var(--page); }
  body { margin: 0; }
