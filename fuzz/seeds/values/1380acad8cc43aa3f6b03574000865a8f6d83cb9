  .panel { padding: 40px; border: 1px solid #d0d7de; background-color: #ffffff; }
  /* A square ring, its top side the colour that turns. */
  .spinner { width: 72px; height: 72px; margin: 0 auto 24px auto; border: 12px solid #d8dee4; border-top-color: #3a7a4a;
             animation: spin 1s linear infinite; }
  @keyframes spin { to { rotate: 360deg; } }
  /* The page's own answer to a user who asked for less motion. */
  @media (prefers-reduced-motion: reduce) {
    .spinner { animation: none; }
  }
