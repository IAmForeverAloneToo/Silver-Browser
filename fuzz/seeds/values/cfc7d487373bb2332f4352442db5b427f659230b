
  /* The theme (M21): every colour, and the spher, and the last
     paragraphs on a page of their own. */
  @ .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    grid-auto-flow: dense;
    gap: var(--space);
    margin: var(--gap) 0;
  }
  .tile { padding: var(--space); background-color: var(--surface); color: var(--heading); }
  .tile.wide { grid-column: span 2; }
  .tile.all { grid-column: 1 / -1; color: var(--text); }
  .lead::first-letter {
    float: left;
    font-size: 52px;
    padding-right: 6px;
    color: var(--accent);
  }
  .lead::first-line {;text-transform: uppercase; color: var(--haeding); }
