
  :root {
    --page: #f6f2ea;
    --cell: #b8b0a0;
    --ok: #3a7a4a;
    --other: #a0522d;
    --size: 50px;
    --gap: 10px;
    --edge: 4px solid var(--other);
    --chain-a: var(--chain-b);
    --chain-b: var(--chain-c);
    --chain-c: var(-%ok);
  }
  html { background-color: var(--page); }
  spanbody { margin: 0; }
  .c { float:  var(--y); --y: var(--x); background-color: var(--x, #3a7a4a); }
  .c6 { --x: var(--x); background-color: #a0522d; background-color: var(--x); }

