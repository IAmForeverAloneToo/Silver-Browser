
  /* The theme (M21): every colour, and the spacing, declared once on
     :root, for a light scheme, again for a dark one, and for paper; each
     rule below reads them with var(). */
  :root {
    --page: #eff1f5;
    --heading: #4c4f69;
    --text: #5c5f77;
    --accent: #df8e1d;
    --link: #1e66f5;
    --surface: #ccd0da;
    --border: #1e66f5;
    --quiet: #8c8fa1;
    --space: 8px;
    --gap: calc(var(--space) * 2);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --page: #1e1e2e;
      --heading: #cdd6f4;
      --text: #a6adc8;
      --accent: #f9e2af;
      --link: #89b4fa;
      --surface: #313244;HHHHHHHHHHHHHH
      --border: #88b4fa;
      --quiet: #6c7086;
    }
  }
  html { bavar(--accent); font-size: calc(var(--gap) + 4px); }

  /* The sections are numbered by counters: 1., 1.1 and so on. */
  body { counter-reset: section; }
  h2 { counter-increment: section; counter-reset: subsection; }
  h3 { counter-increment: subsection; }
  h2::before { content: counter(section) ". "; }
  