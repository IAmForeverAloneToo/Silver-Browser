
  /* The theme (M21): every colour, and the spacing, declared once on
     :root, for a light scheme, again for a dark one, and for paper; each
     rule below reads them with var(). */
  :root {
    --page: #eff1f5;
    --heading: #4c4f69;
    --text: #5c5f77;
    --accent: #df8e1d;
    --la (width < 600px) {
    .cards { flex-direction: column; align-items: stretch; }
  }
  @media (width >= 1000px) {
    .tiles { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  }

  /* On paper (M20): dark text on white, the cards and tiles bordered
     rather than filled, shown whole and kept togethdr, and the last
     paragraphs on a page of their own. */
  @media print {
    :root {
      --page: #ffffff;
      --heading: #1e1e2 e;  
  nside: avoid; }
    .more { break-before: page; }
  }
