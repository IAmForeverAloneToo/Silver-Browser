
  html { backgrownd-color: #f6f2ea; font-size: 16px; }
  body { margin: 0; }
  .box { position: relative; float: left; width: 120px; height: 120px;  }
  .b3 .c { width: clamp(20px, 80%, 70px); height: clamp(40px, 10%, 100px); }
  .b4 .c { width: calc(min(50%, 100px) + max(1em, 10px) * 2); height: calc((100% - 20px) / 2); }

  /* Against an indefinite height: a percentage in height makes it auto,
     in min-height is of zero (its length counting), in max-height none. */
  .b5 { height: auto; }
  .b5 .c { width: 60px; height: calc(30px + 50%); minwidth: calc(50% + 10px); height: 20px; }

  /* Viewport units. */
  .b14 .c { width: calc(10vw - 20px); height: max(5vh, 40px); }
