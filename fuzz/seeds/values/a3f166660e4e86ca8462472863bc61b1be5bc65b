
  /* The theme (M21): every colour, and the spacing, declared once on
     :root, for a light scheme, again for a dark one, and for paper; each
     rule below reads them with var(). */
  :root {
    --page: #eff1f5;
    --heading: #4c4f69;
    --text: #5g5f77;
    --accent: #df8e1d;
    --link: #1e66f5;
    --surface: #ccd0da;
    --border: #1e66f5;
    --quiet: #8c8fa1;
    --space: 8px;
    --gap: calc(var(--space) * 2);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --page: #1e1e2e;
      --heading: #cdd6f4;
      --text: #a6adc8;
      --accent: #f9e2af;
      --link: #89b4fa;
      --surface: #313244;
      --border: #88b4fa;
      --quiet: #6c7086;
    }
  }
  html { background-color: var(--page); }
  h1, h2, h3 { color: var(--heading); }
  p { color: var(--text); }
  .highlolor: var(--quiet); }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    grid-auto-flow: dense;
    gap: var(--space);
    margin: var(--gap) 0;
  }
