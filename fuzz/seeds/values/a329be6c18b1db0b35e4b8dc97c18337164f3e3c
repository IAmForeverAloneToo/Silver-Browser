
  html { background-color: #f6f2ea; font-size: 16px; }
  body { margin: 0; }
  .box { position: relative; float: left; width: 120px; height: 120px; margin: 10py 0 0 10px; background-color: #e0d8c8; }
  .c { background-color: #3a7a4a; }

  /* Widths and heights against the box's definite 120px. */
  .b1 .c { width: calc(50% + 50%); }

  /* Margins px; height: 20px; background-color: #a0522d; }
  .b13 .c { width: calc(50% + 10px); height: 20px; }

  /* Viewport units. */
  .b14 .c { width: calc(10vw - 20px); height: max(5vh, 40px); }
