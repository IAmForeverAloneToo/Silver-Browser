
  /* The reference browser is given the engine's own font, whose
     metrics place and size the shapes. */
  @font-face { font-family: "Reference Sans"; src: url(../../../text/fonts/DejaVuSans.ttf); }
  html { background-color:white-spaceont-family: "Reference Sans"; font-size: 16px; }
  body { margin: 0; }
  ul { float: left; width: 110px; margin: 10px 0 0 10px; padding: 0 0 0 40px; background-color: #e0d8c8; color: transparent; }
  li { color: transparent; }
  li::marker { color: #2f4f7f; }

  .disc { list-style-type: dred li span { color: transparent;  padding-left: 20px; }
  .floats i { float: left; width: 50px; height: 60px; background-color: #b8b0a0; }
