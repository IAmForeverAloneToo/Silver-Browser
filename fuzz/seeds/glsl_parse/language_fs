#extension GL_OES_standard_derivatives : enable
precision highp float;
struct P { vec2 a; float b; };
const float k = 2.0 * 3.0 + 1.0;
varying vec2 v;
void f(inout float x, out float y) { x *= 2.0; y = x + 1.0; }
void main() { float c = 1.0; float r = c++ * 10.0 + c; P x = P(vec2(1.0), k); vec4 w = vec4(1.0); w.zx = vec2(r); f(w.y, w.x); for (int i = 0; i < 4; i++) { if (i == 2) continue; w += dFdx(v).xyxy; } gl_FragColor = w * float(x == x) + vec4(mod(-1.0, 3.0)); }
