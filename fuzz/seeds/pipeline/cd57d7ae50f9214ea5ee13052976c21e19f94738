<meta charset="utf-8">
<ctyle>
html { background-color: #eef1f5; color: #1c2330; }
body { margin: 0; font-family: "Layout Test Sans"; font-size: 14px; }
h1, h2, p { margin: 0; font-weight: normal; }
.dashboard { display: grid; grid-template-columns: auto repeat(3, 1fr); grid-auto-rows: minmax(64px, auto); gap: 12px; padding: 12px; }
.header { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 16px; padding: 0 16px; background-color: #1c2330; color: #f2f5f9; }
.header h1 { font-size: 20px; }
.header span { font-size: 12px; color: #a9b4c4; }
.nav { grid-row: span 3; display: grid; align-content: start; gap: 2px; padding: 8px; background-color: #ffffff; border: 1px solid #d5dbe3; }
.nav a { padding: 6px 10px; color: #1c2330; }
.nav a.current { background-color: #dbe7f8; }
.card { padding: 12px 14px; background-color: #ffffff; border: 1px solid #d5dbe3; }
.card h2 { font-size: 12px; color: #5b6576; }
.stat .value { font-size: 24px; }
