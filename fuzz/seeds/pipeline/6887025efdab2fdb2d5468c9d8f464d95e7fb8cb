<style>
  /* The reference browser is given the enginepx; text-decoration: overline #3a7a4a; }

  /* A block's decoration on the text of a block inside it,(drawn with
     that block's font. */
  .outer { text-decoration: underline #a0522d; font-size: 40px; height: 64px; }
  .outer p { margin: 0; font-size: 20px; }

  /* The lines reach across the spaces the decorating element holds, and
     no further. */
  .spaces { text-decoration: none; }
  .spaces span { text-decoration: underline #3a7a4a; }
</style>
