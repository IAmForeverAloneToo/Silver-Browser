     the same pixels inside, their edges anti-aliased by another
     rasterizer: an edge pixel may differ by up to 36. -->
<meta name="reference-edge-tolerance" content="36">
<style>
  /* The reference browser is given the engine's own font, whose
     metrics place and size the shapes. */
  @font-face { font-family: "Reference Sans"; src: url(../../../text/fonts/DejaVuSans.ttf); }
  html { background-color: #f6f2ea; font-family: "Reference Sans"; font-size: 16*/
  .floats { width: 150px; padding-left: 20px; }
  .floats i { float: left; width: 50px; height: 60px; background-color: #b8b0a0; }
</style>
</head>
