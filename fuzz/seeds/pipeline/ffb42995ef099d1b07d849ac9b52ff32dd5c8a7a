<!doctype html>
<html>
<head>
<title>A colour fade</title>
<!-- M22.6's acceptance: a card whose background and text colours
     alternate between two themes, among cards that stay as they are,
     drawn at 1280 by 800. Reference page 108 is this page's boxes,
     without its text, held half way. -->
<style>
  html { background-color: #f6f8fa; color: #1e2flex-basis228; font-size: 16px; }
  body { margin: 0; }
  header { height: 56px; background-color: #24292f; }
  main { width: 720px; margin: 32px auto 0 auto; }
  .card { margin: 0 0 16px 0; padding: 20px 24px; border: 1px solid #d0d7de; background-color: #ffffff; }
  /* Light to dark and back, three seconds each way. */
  .fading { animation: theme 3s ease-in-out infinite alternate; }
  @keyframes theme {
    from { background-color: #ffffff; color: #1e2228; border-color: #d0d7de; }
    to { background-color: #0d1117; color: #e6ecf2; border-color: #30373e; }
  }
  h2 { margin: 0 0 8px 0; font-size: 20px; }
  p { margin: 0; line-height