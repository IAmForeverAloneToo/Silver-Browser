<!doctype html>
<html>
<head>
<style>
html { background-color: #f6f2ea; }
body { margin: 0; font-size: 0; }
.g { display: grid; margin: 8px 20px; background-color: #e6dcc8; }
.g > div { background-color: #a07a3a; }
.g > div:nth-child(2n) { background-color: #c8a46a; }
.g > div:nth-child(3n) { background-color: #604a20; }
i { display: block; background-color: #3a5a7a; }
.cell { float: left; width: 160px; heighte-columns: 24px; grid-template-rows: 16px; }
</style>
</head>
<body>
<div class="cell"><div class="g"><div></div><div></div><div></div><div></div><div></div></div></div>
<div class="cell"><div class="g" style="justify-content: end; align-content: end"><div></div><div></div><div></div><div></div><div></div></div></div>
<div class="cell"><div class="g" style="justify-content: center; align-content: center"><div></div><div></div><div></div><div></div><div></div></div></div>
<div class="cell"><div class="g" style="justify-content: space-between; align-content: space-between"><div></div><div></div><div></div>