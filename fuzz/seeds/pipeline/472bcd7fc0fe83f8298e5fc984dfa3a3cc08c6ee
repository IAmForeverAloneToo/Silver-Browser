<!doctype html>
<html>
<head>
<title>Flex: row-reverse and column-reverse, the main start turned round, justify-content with them, start and end not, an auto margin, wrapping</title>
<style>
  html { background-color: #f6f4ee; }
  body { margin: 0; }
  .rows { float: left; width: 380px; }
  .f { display: flex; flex-direction: row-reverse; width: 330px; height: 24px; margin: 8px 20px; background-color: #e8e2cc; }
  .f div { flex: none; width: 50px; height: 20px; background-color: #8a7a3a; }
  .f div:nth-child(3n+2) { background-color: #cab87a; }
  .f div:nth-child(3n) { background-color: #4a3e14; }
  .wrap { flex-wrap: wrap; height: auto; }
  .push { margin-left: auto; }
  .c { flex-direction: column-reverse; float: left; width: 50px; height: 200px; margin: 8px 0 0 14px; }
  .c div { width: 40px; height: 30px; }
  .c.auto { height: auto; }
  .c.wrap { flex-wrap: wrap; height: 130px; width: 90px; }
</style>
</head>
<body>
